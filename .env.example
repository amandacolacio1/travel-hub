# Copie para `.env` e preencha com os dados do Neon (Dashboard → Connect).
# Nunca commite o `.env` — ele já está no .gitignore.

# Conexão COM pooling (host com "-pooler"). Usada pelo app em runtime.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.REGIAO.aws.neon.tech/travelhub?sslmode=verify-full"

# Conexão DIRETA (mesmo host, sem "-pooler"). Usada só pelo Prisma CLI (migrate).
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxx.REGIAO.aws.neon.tech/travelhub?sslmode=verify-full"

# Quem gera as fichas dos destinos. Vazio = "fake" (sem IA, sem custo, dados de exemplo).
# Gere as fichas iniciais com `npm run ai:profiles`.
AI_PROVIDER="fake"
